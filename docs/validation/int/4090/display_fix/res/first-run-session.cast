[7.997203, "o", "\u001b[?2026h\u001b[?25l\u001b[9;1H           \u001b[2m\u256d\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u256e\u001b[0m\u001b[K\u001b[10;1H           \u001b[2m\u2502\u001b[0m                                                                          \u001b[2m\u2502\u001b[0m\u001b[K\u001b[11;1H           \u001b[2m\u2502\u001b[0m                      \u001b[1mporos\u001b[0m                                               \u001b[2m\u2502\u001b[0m\u001b[K\u001b[12;1H           \u001b[2m\u2502\u001b[0m                                                                          \u001b[2m\u2502\u001b[0m\u001b[K\u001b[13;1H           \u001b[2m\u2502\u001b[0m                      \u001b[39mFine-tune models bigger than your GPU.\u001b[0m              \u001b[2m\u2502\u001b[0m\u001b[K\u001b[14;1H           \u001b[2m\u2502\u001b[0m    \u001b[1;38;5;208m\u2588\u2588\u2588\u2588\u2588\u2588\u001b[0m \u001b[1;38;5;208m\u2588\u2588\u2588\u2588\u2588\u2588\u001b[0m     \u001b[2mRTX 4090 \u00b7 23.5 GiB free\u001b[0m                            \u001b[2m\u2502\u001b[0m\u001b[K\u001b[15;1H           \u001b[2m\u2502\u001b[0m    \u001b[1;38;5;208m\u2588\u2588\u2588\u2588\u2588\u2588\u001b[0m \u001b[1;38;5;208m\u2588\u2588\u2588\u2588\u2588\u2588\u001b[0m                                                         \u001b[2m\u2502\u001b[0m\u001b[K\u001b[16;1H           \u001b[2m\u2502\u001b[0m    \u001b[1;38;5;208m\u2588\u2588\u2588\u2588\u2588\u2580\u001b[0m \u001b[1;38;5;208m\u2580\u2588\u2588\u2588\u2588\u2588\u001b[0m     \u001b[39mStart from a recipe\u001b[0m                       \u001