[5.297052, "o", "\u001b[?2026h\u001b[?25l\u001b[9;1H           \u001b[2m\u256d\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u256e\u001b[0m\u001b[K\u001b[10;1H           \u001b[2m\u2502\u001b[0m                                                                          \u001b[2m\u2502\u001b[0m\u001b[K\u001b[11;1H           \u001b[2m\u2502\u001b[0m                      \u001b[1mporos\u001b[0m                                               \u001b[2m\u2502\u001b[0m\u001b[K\u001b[12;1H           \u001b[2m\u2502\u001b[0m                                                                          \u001b[2m\u2502\u001b[0m\u001b[K\u001b[13;1H           \u001b[2m\u2502\u001b[0m                      \u001b[39mFine-tune models bigger than your GPU.\u001b[0m              \u001b[2m\u2502\u001b[0m\u001b[K\u001b[14;1H           \u001b[2m\u2502\u001b[0m    \u001b[1;38;5;208m\u2588\u2588\u2588\u2588\u2588\u2588\u001b[0m \u001b[1;38;5;208m\u2588\u2588\u2588\u2588\u2588\u2588\u001b[0m     \u001b[2mRTX 4090 \u00b7 23.5 GiB free\u001b[0m                            \u001b[2m\u2502\u001b[0m\u001b[K\u001b[15;1H           \u001b[2m\u2502\u001b[0m    \u001b[1;38;5;208m\u2588\u2588\u2588\u2588\u2588\u2588\u001b[0m \u001b[1;38;5;208m\u2588\u2588\u2588\u2588\u2588\u2588\u001b[0m                                                         \u001b[2m\u2502\u001b[0m\u001b[K\u001b[16;1H           \u001b[2m\u2502\u001b[0m    \u001b[1;38;5;208m\u2588\u2588\u2588\u2588\u2588\u2580\u001b[0m \u001b[1;38;5;208m\u2580\u2588\u2588\u2588\u2588\u2588\u001b[0m     \u001b[39mStart from a recipe\u001b[0m                       \u001b[2m/recipes\u001b[0m  \u001b[2m\u2502\u001b[0m\u001b[K\u001b[17;1H           \u001b[2m\u2502\u001b[0m    \u001b[1;38;5;208m\u2588\u2588\u2580\u001b[0m       \u001b[1;38;5;208m\u2580\u2588\u2588\u001b[0m     \u001b[39mSet up your own run\u001b[0m                         \u001b[2m/train\u001b[0m  \u001b[2m\u2502\u001b[0m\u001b[K\u001b[18;1H           \u001b[2m\u2502\u001b[0m    \u001b[1;38;5;208m\u2588\u2588\u001b[0m         \u001b[1;38;5;208m\u2588\u2588\u001b[0m     \u001b[39mWatch your runs\u001b[0m                              \u001b[2m/runs\u001b[0m  \u001b[2m\u2502\u001b[0m\u001b[K\u001b[19;1H           \u001b[2m\u2502\u001b[0m                      \u001b[39mEvery command\u001b[0m                                    \u001b[2m\u23ce\u001b[0m  \u001b[2m\u2502\u001b[0m\u001b[K\u001b[20;1H           \u001b[2m\u2502\u001b[0m                      \u001b[39mQuit\u001b[0m                                        \u001b[2mctrl+d\u001b[0m  \u001b[2m\u2502\u001b[0m\u001b[K\u001b[21;1H           \u001b[2m\u2502\u001b[0m                                                                          \u001b[2m\u2502\u001b[0m\u001b[K\u001b[22;1H           \u001b[2m\u2570\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u256f\u001b[0m\u001b[K\u001b[26;1H\u001b[K\u001b[27;1H\u001b[K\u001b[28;1H\u001b[K\u001b[29;1H\u001b[90m\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500