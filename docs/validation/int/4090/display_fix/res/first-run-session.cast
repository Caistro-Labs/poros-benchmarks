b[2m/recipes\u001b[0m  \u001b[2m\u2502\u001b[0m\u001b[K\u001b[17;1H           \u001b[2m\u2502\u001b[0m    \u001b[1;38;5;208m\u2588\u2588\u2580\u001b[0m       \u001b[1;38;5;208m\u2580\u2588\u2588\u001b[0m     \u001b[39mSet up your own run\u001b[0m                         \u001b[2m/train\u001b[0m  \u001b[2m\u2502\u001b[0m\u001b[K\u001b[18;1H           \u001b[2m\u2502\u001b[0m    \u001b[1;38;5;208m\u2588\u2588\u001b[0m         \u001b[1;38;5;208m\u2588\u2588\u001b[0m     \u001b[39mWatch your runs\u001b[0m                              \u001b[2m/runs\u001b[0m  \u001b[2m\u2502\u001b[0m\u001b[K\u001b[19;1H           \u001b[2m\u2502\u001b[0m                      \u001b[39mEvery command\u001b[0m                                    \u001b[2m\u23ce\u001b[0m  \u001b[2m\u2502\u001b[0m\u001b[K\u001b[20;1H           \u001b[2m\u2502\u001b[0m                      \u001b[39mQuit\u001b[0m                                        \u001b[2mctrl+d\u001b[0m  \u001b[2m\u2502\u001b[0m\u001b[K\u001b[21;1H           \u001b[2m\u2502\u001b[0m                                                                          \u001b[2m\u2502\u001b[0m\u001b[K\u001b[22;1H           \u001b[2m\u2570\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u256f\u001b[0m\u001b[K\u001b[28;1H\u001b[K\u001b[29;1H\u001b[90m\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u25